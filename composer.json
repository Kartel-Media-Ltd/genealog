{
    "name": "genealog/app",
    "description": "System do budowania drzew genealogicznych rodziny",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": "php -S localhost:8002 -t public/",
        "test": "./vendor/bin/phpunit tests/ --colors=always",
        "phpstan": "./vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
