# Genealog — example environment variables
# Kopiuj do .env.local i uzupełnij rzeczywiste wartości. NIGDY nie commituj .env.local.

# --- Database (MariaDB/MySQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=genealog
DATABASE_USER=genealog
DATABASE_PASSWORD=changeme

# --- Application ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://genealog.example.com
# Losowa 32-bajtowa wartość, np. `openssl rand -base64 32`
APP_KEY=__generate_with_openssl_rand_base64_32__

# --- Storage ---
# Absolutna ścieżka do katalogu storage (poza public/). Kasowane przy account deletion.
STORAGE_PATH=/var/www/genealog/storage

# --- Mail (SMTP) ---
MAIL_FROM_ADDRESS=noreply@genealog.example.com
MAIL_FROM_NAME="Genealog"
# Opcjonalnie — jeśli używasz zewnętrznego SMTP relay zamiast systemowego mail():
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@genealog.example.com
# SMTP_PASSWORD=__smtp_password__
# SMTP_ENCRYPTION=tls

# --- Security ---
BCRYPT_COST=12
# Limity rate-limitera (auth endpoints)
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=900

# --- Session ---
SESSION_LIFETIME=7200       # 2h inactivity
SESSION_ABSOLUTE_LIFETIME=28800 # 8h absolute

# --- External APIs (opcjonalnie) ---
# FamilySearch OAuth
# FAMILYSEARCH_CLIENT_ID=
# FAMILYSEARCH_CLIENT_SECRET=
# FAMILYSEARCH_REDIRECT_URI=https://genealog.example.com/api/familysearch/callback

# --- Python scraper microservice (opcjonalnie) ---
# SCRAPER_URL=http://scraper:8001

# --- Discovery / global index ---
# Próg historyczności (lata): ile lat od roku urodzenia osoba musi mieć, żeby trafić do globalnego
# indeksu kojarzenia rodzin. Osoby bez daty urodzenia oznaczone jako nieżyjące są zawsze historyczne.
# Domyślnie 100 (zgodnie z zasadą 100 lat RODO). Można obniżyć np. do 50 dla szerszego matchingu.
DISCOVERY_HISTORICAL_YEARS=100

# --- DPO / Contact ---
# DPO_EMAIL=dpo@genealog.example.com
# ADMIN_EMAIL=admin@genealog.example.com
