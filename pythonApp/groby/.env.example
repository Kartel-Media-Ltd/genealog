# Kopiuj jako .env i uzupełnij wartości
# cp .env.example .env

# ---- Rejestry ----
# Włącz/wyłącz poszczególne rejestry (domyślnie wyłączone — wymaga weryfikacji robots.txt i selektorów CSS)
GROBONET_ENABLED=true
ECMENTARZE_ENABLED=false   # włącz po weryfikacji robots.txt
MOGILY_ENABLED=false        # włącz po weryfikacji robots.txt i inspekcji DOM
CMENTARZE24_ENABLED=false   # włącz po weryfikacji robots.txt i inspekcji DOM

# ---- Bezpieczeństwo ----
# Sekretny klucz API — PHP wysyła go w nagłówku X-API-Secret
# Zostaw puste żeby wyłączyć autoryzację (tylko lokalnie!)
API_SECRET=zmien_na_losowy_ciag_znakow

# ---- Serwis ----
PORT=8010
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# ---- PHP Genealog ----
# URL aplikacji PHP — dla CORS
SITE_URL=http://localhost:8002
